rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Leaderboard: 클라이언트는 읽기만 (top-N 직접 쿼리). 쓰기는 Cloud Function(Admin SDK)만.
    // leaderboard_global, leaderboard_weekly_{YYYYWW} 등 leaderboard_ 로 시작하는 모든 컬렉션.
    match /{col}/{doc} {
      allow read: if col.matches('^leaderboard_.*$');
      allow write: if false; // 클라이언트 직접 쓰기 차단 — submitScore/setName 함수 사용
    }

    // 게임 세션 (안티치트 앵커): 함수 전용. 클라이언트 접근 전면 차단.
    match /game_sessions/{token} {
      allow read, write: if false;
    }

    // 서버 전용 config: 클라이언트 접근 없음.
    match /config/{docId} {
      allow read, write: if false;
    }

    // IAP 멱등성 원장 (전역 {platform}:{txId}): 함수(Admin SDK) 전용. 클라이언트 차단.
    match /processed_transactions/{id} {
      allow read, write: if false;
    }

    // 유저 데이터: 본인만 읽기. 화이트리스트 필드만 생성/수정 가능.
    // ⚠️ name/bestScore는 화이트리스트에서 제외 — 둘 다 서버 권위 필드다 (플레이북 §5).
    //   - name: setName 함수가 blocklist+길이로 모더레이션한다. 룰로 직접 쓰게 두면
    //     악성 클라가 updateDoc({name:'<욕설>'})로 모더레이션을 우회하고, submitScore가
    //     그 값을 리더보드로 전파한다(글로벌 #1 욕설 → 스토어 리젝). Admin SDK 전용 쓰기.
    //   - bestScore: submitScore가 세션 검증 후에만 갱신. 클라 쓰기 불필요.
    // (서버는 Admin SDK라 룰을 우회하므로 name/bestScore 서버 갱신은 영향 없음.)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // 클라이언트 쓰기 전면 차단. 이 문서의 모든 필드는 Cloud Functions(Admin SDK)가
      // 쓰고, Admin SDK 는 룰을 우회하므로 서버 동작에는 영향이 없다. 클라는 이 컬렉션에
      // write 를 한 번도 하지 않는다(index.html 의 fbDb 사용처 = settings() 설정 +
      // leaderboard_global 읽기뿐).
      //
      // 화이트리스트를 아예 없앤 이유 — 남겨두면 어떤 필드든 경제로 새기 때문:
      //  - createdAt : 클라가 과거 시각을 쓰면 coinSystem.js 의 preCutoff 가 성립.
      //  - bestScore : 클라가 쓰면 createdAt 없이도 legacyNoCreatedAt 이 성립.
      //    둘 중 하나만 통과해도 importEligible → 신규 계정이 import_cap 까지
      //    (코인 30,000 + 젬 120 + 스킨) 무료로 받는다 = coins.30000 SKU 를 공짜로.
      //  - name : setName 의 blocklist/길이 모더레이션을 우회해 submitScore 를 타고
      //    공개 리더보드로 전파된다(욕설 글로벌 #1 → 스토어 리젝).
      //  - stableId : 타인의 기기 식별자를 선점해 복구 경로를 오염시킬 수 있다.
      allow write: if false;
    }
  }
}
